---
import { CATEGORY_LABELS, categoryPath, type Category } from '@hamza/shared';

import Icon from '../icons/Icon.astro';

export interface CategoryTile {
  readonly category: Category;
  readonly count: number;
}

interface Props {
  tiles: readonly CategoryTile[];
}

const { tiles } = Astro.props;

/** The one-line promise under each category name, as in the design. */
const META: Readonly<Record<string, string>> = {
  women: 'Khussa, heels, flats',
  men: 'Sneakers, loafers, formal',
  kids: 'School shoes, sandals',
};

/*
 * The design fills each tile with a cover photograph and lays a plate over it.
 *
 * These are the mock's own photographs, self-hosted at `/category/` — never
 * fetched from images.unsplash.com, which rule 3 forbids and which the handoff
 * itself tells us not to ship.
 *
 * An earlier version used the newest photographed product in each category
 * instead, on the principle that the shop's own photos beat anyone else's. In
 * practice it looked wrong: catalogue photography is a cut-out shoe on a pale
 * background, and stretched to fill a 260px tile it reads as an empty box. The
 * design is asking for a mood image here, not a product shot — the same call
 * already made for the home hero. Nothing on a tile claims to be for sale: no
 * price, no name, no size, and `alt` is empty because the category name sits in
 * the plate directly below.
 *
 * These are placeholders by the design's own account, to be replaced with the
 * shop's photography. That swap is a file drop into `public/category/`, not a
 * code change — the names and sizes below are the whole contract.
 */
const WIDTHS = [480, 960] as const;

function srcset(category: Category): string {
  return WIDTHS.map((width) => `/category/${category}-${width}.webp ${width}w`).join(', ');
}
---

<nav aria-label="Shop by category">
  <ul class="grid gap-3 sm:grid-cols-3 sm:gap-4">
    {
      tiles.map(({ category, count }) => (
        <li>
          <a
            href={categoryPath(category)}
            class="group relative flex h-[180px] flex-col justify-end overflow-hidden rounded-[14px] border border-line bg-surface-warm p-4 transition-colors hover:border-brand-600 sm:h-[260px]"
          >
            <img
              src={`/category/${category}-960.webp`}
              srcset={srcset(category)}
              sizes="(min-width: 640px) 33vw, 100vw"
              alt=""
              width="960"
              height="520"
              loading="lazy"
              decoding="async"
              class="absolute inset-0 h-full w-full object-cover transition-transform duration-300 group-hover:scale-[1.04]"
            />

            {/* Scrim so the plate never sits on a busy part of the photo. */}
            <span
              aria-hidden="true"
              class="absolute inset-0 bg-gradient-to-t from-ink/35 to-transparent to-55%"
            />

            <span class="relative flex items-center justify-between gap-3 rounded-[10px] bg-surface px-4 py-3.5">
              <span>
                <span class="block text-[19px] font-extrabold text-ink">
                  {CATEGORY_LABELS[category]}
                </span>
                <span class="mt-0.5 block text-[13px] text-ink-soft">
                  {META[category]}
                  {count > 0 && ` · ${count} styles`}
                </span>
              </span>
              <Icon name="arrow-right" size={20} class="text-brand-600" />
            </span>
          </a>
        </li>
      ))
    }
  </ul>
</nav>
