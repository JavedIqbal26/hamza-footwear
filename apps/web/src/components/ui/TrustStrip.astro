---
import { TRUST } from '../../content/microcopy.js';

/**
 * The reassurances that decide whether a first-time visitor from TikTok orders
 * at all. Roman Urdu, because this is the trust moment.
 *
 * Cash on Delivery is deliberately absent: it already sits in the sticky header
 * banner on every page. Repeating it here word for word cost a third of this
 * strip and taught the eye to skip the whole row. Sizing takes its place —
 * the other thing a first-time buyer hesitates over.
 */
const POINTS = [
  { title: 'Delivery', body: TRUST.deliveryTime },
  { title: 'Exchange', body: TRUST.returns },
  { title: 'Sizing', body: TRUST.sizeHelp },
] as const;
---

<section aria-label="Why order from us" class="mx-auto max-w-5xl px-4 pt-8">
  <ul class="grid gap-3 sm:grid-cols-3">
    {
      POINTS.map((point) => (
        <li class="rounded-lg bg-brand-50 px-4 py-3">
          <h3 class="text-xs font-semibold uppercase tracking-wide text-brand-700">
            {point.title}
          </h3>
          <p class="mt-1 text-sm text-ink">{point.body}</p>
        </li>
      ))
    }
  </ul>
</section>
