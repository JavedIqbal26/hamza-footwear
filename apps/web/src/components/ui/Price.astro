---
import { effectivePricePkr, formatPKR, isOnSale } from '@hamza/shared';

interface Props {
  price_pkr: number;
  sale_price_pkr: number | null;
  /** Product pages want a larger, louder price than listing cards. */
  size?: 'sm' | 'lg';
}

const { price_pkr, sale_price_pkr, size = 'sm' } = Astro.props;

const product = { price_pkr, sale_price_pkr };
const now = effectivePricePkr(product);
const onSale = isOnSale(product);
---

{/*
  The discount percentage lives on the product image as a badge, not here —
  repeating it beside the price crowds the line the eye actually reads.
*/}
<p class="flex flex-wrap items-baseline gap-x-2 gap-y-0.5">
  <span class:list={['font-extrabold text-ink', size === 'lg' ? 'text-[25px]' : 'text-base sm:text-[19px]']}>
    {formatPKR(now)}
  </span>

  {
    onSale && (
      <span
        class:list={[
          'text-ink-label line-through',
          size === 'lg' ? 'text-[15px]' : 'text-xs sm:text-sm',
        ]}
      >
        {formatPKR(price_pkr)}
      </span>
    )
  }
</p>
