---
import Icon from '../icons/Icon.astro';
import { TRUST } from '../../content/microcopy.js';

/**
 * The three questions a COD buyer needs answered before they will tap Add to
 * cart: how they pay, when it arrives, and what happens if the size is wrong.
 *
 * Above the description on purpose — nobody reads the materials paragraph
 * before they have decided the shop is safe to order from.
 */
const PROMISES = [
  { icon: 'rupee' as const, title: 'Cash on Delivery', body: TRUST.cod },
  { icon: 'truck' as const, title: '2–4 din delivery', body: TRUST.deliveryFeeNote },
  { icon: 'exchange' as const, title: '7-day free exchange', body: TRUST.returnsCondition },
] as const;
---

<ul class="overflow-hidden rounded-[16px] border border-line">
  {
    PROMISES.map((promise) => (
      <li class="flex gap-3 border-b border-line-soft px-4 py-3.5 last:border-b-0">
        <Icon name={promise.icon} size={18} class="mt-0.5 text-brand-600" />
        <span>
          <span class="block text-sm font-extrabold">{promise.title}</span>
          <span class="mt-0.5 block text-[13px] leading-relaxed text-ink-muted">
            {promise.body}
          </span>
        </span>
      </li>
    ))
  }
</ul>
