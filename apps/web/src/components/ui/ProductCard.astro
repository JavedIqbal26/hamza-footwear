---
import {
  buildWhatsAppOrderLink,
  CATEGORY_LABELS,
  discountPercent,
  effectivePricePkr,
  isOnSale,
  isOrderable,
  NO_RATING,
  primaryImage,
  productPath,
  sortUkSizes,
  type Product,
  type RatingSummary,
} from '@hamza/shared';

import Icon from '../icons/Icon.astro';
import Price from './Price.astro';
import ProductImage from './ProductImage.astro';
import SaveButton from './SaveButton.astro';
import Stars from './Stars.astro';
import { TRUST } from '../../content/microcopy.js';

interface Props {
  product: Product;
  rating?: RatingSummary;
  saved?: boolean;
  shopPhone?: string;
  /** Carried through from `?v=` so the video reference survives navigation. */
  videoRef?: string | null;
  /** The first row of a grid is above the fold on a phone. */
  eager?: boolean;
  returnTo?: string;
}

const {
  product,
  rating = NO_RATING,
  saved = false,
  shopPhone = '',
  videoRef = null,
  eager = false,
  returnTo = '/',
} = Astro.props;

const href = productPath(product.slug, videoRef);
const orderable = isOrderable(product.stock_status);
const onSale = isOnSale(product);
const price = effectivePricePkr(product);
const sizes = sortUkSizes(product.sizes_available).slice(0, 5);

/*
 * "New" is derived from `created_at` rather than stored as a flag: a badge that
 * has to be switched off by hand is a badge that stays on for a year.
 */
const NEW_FOR_DAYS = 21;
const isNew =
  Date.now() - new Date(product.created_at).getTime() < NEW_FOR_DAYS * 864e5;

/*
 * Stock copy is a selling line, not a status label: "only a few left" moves a
 * hesitant buyer, and green vs terracotta carries the urgency without a badge.
 */
const stockLine =
  product.stock_status === 'out'
    ? { text: TRUST.outOfStock, tone: 'text-ink-soft' }
    : product.stock_status === 'low'
      ? { text: TRUST.lowStock, tone: 'text-brand-600' }
      : { text: TRUST.dispatchToday, tone: 'text-stock' };

const whatsappHref = buildWhatsAppOrderLink({
  shopPhone,
  productName: product.name,
  productUrl: new URL(href, Astro.url).href,
  pricePkr: price,
});
---

<article
  class="group flex flex-col overflow-hidden rounded-[14px] border border-line bg-surface transition-shadow hover:border-line-strong hover:shadow-[0_10px_30px_-18px_rgba(23,18,15,0.35)]"
>
  <div class="relative aspect-square overflow-hidden bg-photo">
    <a href={href} class="block">
      <ProductImage
        baseKey={primaryImage(product)}
        alt={product.name}
        variant="thumb"
        sizes="(min-width: 640px) 25vw, 50vw"
        loading={eager ? 'eager' : 'lazy'}
        class="transition-transform duration-300 group-hover:scale-[1.04]"
      />
    </a>

    <span class="absolute left-2.5 top-2.5 flex flex-col items-start gap-1.5">
      {
        isNew && orderable && (
          <span
            class="rounded-full bg-ink px-2.5 py-1.5 text-[11px] font-extrabold uppercase leading-none text-surface"
            style="letter-spacing: 0.08em;"
          >
            New
          </span>
        )
      }
      {
        onSale && (
          <span class="rounded-full bg-brand-600 px-2.5 py-1.5 text-[11px] font-extrabold leading-none text-white">
            {discountPercent(product)}% off
          </span>
        )
      }
      {
        !orderable && (
          <span
            class="rounded-full bg-ink px-2.5 py-1.5 text-[11px] font-extrabold uppercase leading-none text-surface"
            style="letter-spacing: 0.08em;"
          >
            Sold out
          </span>
        )
      }
    </span>

    <SaveButton slug={product.slug} saved={saved} returnTo={returnTo} />
  </div>

  <div class="flex flex-1 flex-col gap-2 p-4">
    <p class="eyebrow">{CATEGORY_LABELS[product.category]}</p>

    <h3 class="text-sm font-bold leading-[1.3] sm:text-base">
      <a href={href} class="hover:text-brand-600">{product.name}</a>
    </h3>

    <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
      <Price price_pkr={product.price_pkr} sale_price_pkr={product.sale_price_pkr} />
      <Stars rating={rating} />
    </div>

    {/*
      Sizes on the card let a shopper rule the shoe out before tapping into it —
      the single biggest saver of pointless product-page loads on mobile data.
    */}
    {
      sizes.length > 0 && (
        <ul class="flex flex-wrap gap-1.5 pt-0.5">
          {sizes.map((size) => (
            <li class="rounded-md border border-line-strong px-2 py-0.5 text-[11px] font-bold text-ink">
              {size}
            </li>
          ))}
        </ul>
      )
    }

    <p class:list={['mt-auto pt-1.5 text-[13px] font-medium', stockLine.tone]}>
      {stockLine.text}
    </p>

    {/*
      Add to cart lives on the card, not just the product page: the design puts
      it here because a shopper who already knows the size should not have to
      load another page. It posts to the same endpoint as the product page and
      needs no JavaScript.

      Without a size the endpoint sends them to the product page with the size
      block flagged, which is the one thing a card cannot ask for in this space.
    */}
    <div class="flex gap-2 pt-1">
      {
        orderable ? (
          <a
            href={href}
            class="tap-target flex flex-1 items-center justify-center rounded-full bg-ink text-sm font-bold text-surface transition-colors hover:bg-brand-600"
          >
            Add to cart
          </a>
        ) : (
          <a
            href={href}
            class="tap-target flex flex-1 items-center justify-center rounded-full border border-line-strong text-sm font-bold text-ink-soft"
          >
            See details
          </a>
        )
      }

      <a
        href={whatsappHref}
        rel="noopener"
        aria-label={`${TRUST.whatsappPrompt}: ${product.name}`}
        class="tap-target flex w-11 items-center justify-center rounded-full border border-line-strong text-ink transition-colors hover:bg-surface-fill"
      >
        <Icon name="whatsapp" size={18} />
      </a>
    </div>
  </div>
</article>
