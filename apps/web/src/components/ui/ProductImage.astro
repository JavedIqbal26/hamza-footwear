---
import { IMAGE_VARIANT_WIDTHS, imageSrcSet, imageUrl, type ImageVariant } from '@hamza/shared';

interface Props {
  /** R2 base key, or null when the product has no photo yet. */
  baseKey: string | null;
  alt: string;
  /** Which variant to use as the `src` fallback. */
  variant?: ImageVariant;
  sizes?: string;
  /** Only the largest image above the fold should be eager. */
  loading?: 'lazy' | 'eager';
  /**
   * Square by default — cards and galleries all want a consistent tile.
   *
   * `fill` is for containers that set their own height (the home hero): it
   * drops the aspect ratio entirely rather than relying on a caller-supplied
   * `lg:aspect-auto`, which loses to this component's own `aspect-square`
   * whenever Tailwind emits them at equal specificity. A prop is unambiguous;
   * class-collision roulette is not.
   */
  ratio?: 'square' | 'fill';
  /**
   * How the image sits in its box.
   *
   * `cover` by default, which is safe because admin now pads every upload to a
   * square before storing it — so there is nothing left to crop. That padding
   * is the real fix: CSS can only crop or letterbox what it is given, and a
   * consistent catalogue needs the stored files to be consistent.
   *
   * `contain` remains for anything uploaded before that change, where the
   * source is still 4:3 or 3:4 and cropping would cut the shoe.
   */
  fit?: 'contain' | 'cover';
  class?: string;
}

const {
  baseKey,
  alt,
  variant = 'product',
  sizes = '(min-width: 640px) 50vw, 100vw',
  loading = 'lazy',
  ratio = 'square',
  fit = 'cover',
  class: className = '',
} = Astro.props;

const width = IMAGE_VARIANT_WIDTHS[variant];
const shape = ratio === 'square' ? 'aspect-square' : 'h-full';
const objectFit = fit === 'contain' ? 'object-contain' : 'object-cover';
---

{
  baseKey ? (
    <img
      src={imageUrl(baseKey, variant)}
      srcset={imageSrcSet(baseKey)}
      sizes={sizes}
      alt={alt}
      width={width}
      height={width}
      loading={loading}
      decoding="async"
      fetchpriority={loading === 'eager' ? 'high' : undefined}
      class:list={[shape, 'w-full bg-photo', objectFit, className]}
    />
  ) : (
    /*
     * No photo yet. An inline SVG placeholder costs no request and keeps the
     * layout identical to a real image, so nothing shifts when photos land.
     */
    <div
      role="img"
      aria-label={`${alt} — photo coming soon`}
      class:list={[shape, 'flex w-full items-center justify-center bg-photo', className]}
    >
      <svg
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.25"
        aria-hidden="true"
        class="h-10 w-10 text-ink-disabled"
      >
        <path d="M2 17.5h20M4 17.5l1.6-5.2a2 2 0 0 1 1.9-1.4h3l2.2 2.1 4.6.8a3 3 0 0 1 2.5 2.4l.2 1.3" />
        <path d="M7.5 10.9V7a1 1 0 0 1 1-1h1.6a1 1 0 0 1 .9.6l.8 1.8" />
      </svg>
    </div>
  )
}
