---
import { CATEGORIES, CATEGORY_LABELS, categoryPath } from '@hamza/shared';

import { PRIMARY_NAV, SITE } from '../../lib/site.js';
import { TRUST } from '../../content/microcopy.js';

interface Props {
  /** Prefills the search box when the page is a search result. */
  query?: string;
  /** Category pages and the product page supply their own header treatment. */
  showChips?: boolean;
}

const { query = '', showChips = true } = Astro.props;
const currentPath = Astro.url.pathname;

/*
 * No cart or wishlist cookie is read here on purpose. This header appears on
 * pages cached at Cloudflare's edge, so anything person-specific baked into it
 * would be served to the next visitor. Both counts are filled in on the client
 * by `header-counts.ts` and start hidden.
 */
function isActive(href: string): boolean {
  return currentPath === href || currentPath.startsWith(`${href}/`);
}

const chip =
  'flex h-9 shrink-0 items-center whitespace-nowrap rounded-full border px-4 text-sm font-semibold';
---

{/* The promise that decides whether a first-time COD buyer stays at all. */}
<div
  class="bg-ink px-4 py-2 text-center text-xs font-medium text-[#f2e7d8] sm:flex sm:justify-center sm:gap-8"
>
  <span class="inline-flex items-center gap-2">
    <span class="inline-block h-1.5 w-1.5 rounded-full bg-whatsapp"></span>
    Cash on Delivery &nbsp;·&nbsp; 7 din mein exchange
  </span>
  <span class="hidden opacity-60 sm:inline">{TRUST.deliveryTime}</span>
</div>

<header
  class="sticky top-0 z-40 border-b border-line bg-surface/95 backdrop-blur supports-[backdrop-filter]:bg-surface/90"
>
  <div class="mx-auto max-w-[1440px] px-4 py-3 sm:px-6">
    <div class="flex items-center gap-3">
      <a href="/" class="flex shrink-0 items-baseline gap-2">
        <span class="display text-2xl text-ink sm:text-[28px]">Hamza</span>
        <span
          class="text-[10px] font-extrabold uppercase text-brand-600 sm:text-[11px]"
          style="letter-spacing: 0.18em;">Footwear</span
        >
      </a>

      <nav aria-label="Categories" class="hidden sm:block">
        <ul class="flex items-center gap-1">
          {
            PRIMARY_NAV.map((link) => (
              <li>
                <a
                  href={link.href}
                  aria-current={isActive(link.href) ? 'page' : undefined}
                  class:list={[
                    'tap-target flex items-center whitespace-nowrap rounded-full px-3.5 text-[15px] font-semibold',
                    isActive(link.href)
                      ? 'bg-surface-fill text-ink'
                      : 'text-ink hover:bg-surface-fill',
                  ]}
                >
                  {link.label}
                </a>
              </li>
            ))
          }
          <li>
            <a
              href="/shop?sale=1"
              class="tap-target flex items-center whitespace-nowrap rounded-full px-3.5 text-[15px] font-semibold text-brand-600 hover:bg-brand-50"
            >
              Sale
            </a>
          </li>
        </ul>
      </nav>

      {/* Search sits inline from md: up; on a phone it gets its own row below. */}
      <form action="/search" method="GET" class="ml-auto hidden items-center md:flex">
        <label for="site-search" class="sr-only">Search products</label>
        <div class="flex items-center gap-2 rounded-full bg-surface-fill px-4 py-2.5">
          <span aria-hidden="true" class="text-sm text-ink-soft">⌕</span>
          <input
            id="site-search"
            name="q"
            type="search"
            value={query}
            placeholder="Khussa, sneaker, size 8…"
            class="w-44 border-none bg-transparent text-sm text-ink outline-none placeholder:text-ink-soft lg:w-52"
          />
        </div>
      </form>

      <div class="ml-auto flex shrink-0 items-center gap-2 md:ml-0">
        <a
          href="/saved"
          data-saved-link
          aria-label="Saved items"
          class="tap-target relative flex items-center justify-center rounded-full border border-line text-ink-soft hover:bg-surface-fill"
        >
          <span aria-hidden="true" class="text-base">♥</span>
          <span
            data-saved-badge
            hidden
            class="absolute -right-1 -top-1 min-w-5 rounded-full bg-brand-600 px-1 text-center text-[11px] font-extrabold leading-5 text-white"
          ></span>
        </a>

        <a
          href="/cart"
          data-cart-link
          aria-label="Cart"
          class="tap-target relative flex items-center justify-center gap-2 rounded-full bg-ink px-3 text-sm font-bold text-surface hover:bg-[#2c2320] sm:px-4"
        >
          <span class="hidden sm:inline">Cart</span>
          <span aria-hidden="true" class="sm:hidden">⌂</span>
          <span
            data-cart-badge
            hidden
            class="absolute -right-1 -top-1 min-w-5 rounded-full bg-brand-600 px-1 text-center text-[11px] font-extrabold leading-5 text-white sm:static sm:min-w-5"
          ></span>
        </a>
      </div>
    </div>

    {/*
      Phone: a full-width search field and a category chip row, exactly as the
      design's home screen has them. Search has to be reachable without a tap
      into another page — it is how a returning customer finds a size.
    */}
    <form action="/search" method="GET" class="mt-3 md:hidden">
      <label for="site-search-mobile" class="sr-only">Search products</label>
      <div class="flex items-center gap-2.5 rounded-[14px] bg-surface-fill px-3.5 py-3">
        <span aria-hidden="true" class="text-[15px] text-ink-soft">⌕</span>
        <input
          id="site-search-mobile"
          name="q"
          type="search"
          value={query}
          placeholder="Khussa, sneaker, size 8…"
          class="w-full border-none bg-transparent text-[15px] text-ink outline-none placeholder:text-ink-soft"
        />
      </div>
    </form>
  </div>

  {
    showChips && (
      <nav aria-label="Categories" class="-mb-px overflow-x-auto px-4 pb-3 md:hidden">
        <ul class="flex w-max gap-2">
          <li>
            <a
              href="/shop"
              class:list={[
                chip,
                currentPath === '/shop'
                  ? 'border-ink bg-ink text-surface'
                  : 'border-line-strong bg-surface text-ink',
              ]}
            >
              All
            </a>
          </li>
          {CATEGORIES.map((category) => (
            <li>
              <a
                href={categoryPath(category)}
                class:list={[
                  chip,
                  isActive(categoryPath(category))
                    ? 'border-ink bg-ink text-surface'
                    : 'border-line-strong bg-surface text-ink',
                ]}
              >
                {CATEGORY_LABELS[category]}
              </a>
            </li>
          ))}
          <li>
            <a
              href="/shop?sale=1"
              class:list={[chip, 'border-line-strong bg-surface text-brand-600']}
            >
              Sale
            </a>
          </li>
        </ul>
      </nav>
    )
  }
</header>

<script>
  import { initHeaderCounts } from '../../scripts/header-counts.js';

  initHeaderCounts();
</script>
