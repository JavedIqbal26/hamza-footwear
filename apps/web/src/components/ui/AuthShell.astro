---
import Icon from '../icons/Icon.astro';
import Logo from './Logo.astro';

interface Props {
  /** 1 = number, 2 = code. Drives the back link. */
  step: 1 | 2;
}

const { step } = Astro.props;

/*
 * Sign-in runs without the site chrome: no nav, no tab bar, no footer. One
 * screen, one decision. The way out — Skip — stays visible throughout, because
 * a login wall that traps a COD shopper loses the sale outright.
 *
 * From `lg:` up it becomes the design's two-panel card: reassurance on the
 * left, the form on the right. On a phone the panel is dropped rather than
 * stacked — stacking it would push the number field below the fold, and that
 * field is the only thing on this screen that matters.
 */
---

<div class="flex min-h-dvh flex-col lg:items-center lg:justify-center lg:bg-surface-sunk lg:p-8">
  <div
    class="mx-auto flex min-h-dvh w-full max-w-md flex-col px-5 pb-10 pt-6 lg:min-h-0 lg:max-w-[1120px] lg:flex-row lg:overflow-hidden lg:rounded-[20px] lg:border lg:border-line-strong lg:bg-surface lg:p-0 lg:shadow-[0_30px_60px_-40px_rgba(23,18,15,0.5)]"
  >
    {/* Reassurance panel — laptop only. */}
    <aside class="relative hidden lg:flex lg:w-1/2 lg:flex-col lg:justify-end lg:bg-surface-warm">
      <img
        src="/hero/storefront-1280.webp"
        srcset="/hero/storefront-800.webp 800w, /hero/storefront-1280.webp 1280w"
        sizes="50vw"
        alt=""
        width="1280"
        height="853"
        loading="lazy"
        decoding="async"
        class="absolute inset-0 h-full w-full object-cover"
      />
      <div
        aria-hidden="true"
        class="absolute inset-0 bg-gradient-to-t from-ink/85 via-ink/30 to-transparent"
      >
      </div>
      <div class="relative flex flex-col gap-2.5 p-8">
        <p class="display text-[30px] text-surface">Poore Pakistan mein delivery</p>
        <p class="text-[14.5px] leading-relaxed text-[#d9cbb6]">
          Cash on Delivery, 7 din return ya exchange, aur har order par WhatsApp update.
        </p>
      </div>
    </aside>

    <div class="flex flex-1 flex-col lg:justify-center lg:p-10">
      <div class="flex items-center justify-between pb-6">
        <a
          href={step === 1 ? '/' : '/account/sign-in'}
          aria-label={step === 1 ? 'Close' : 'Back'}
          class="tap-target flex items-center justify-center rounded-full border border-line text-ink-muted"
        >
          <Icon name={step === 1 ? 'close' : 'arrow-left'} size={20} />
        </a>
        <a
          href="/shop"
          class="tap-target -mr-3 flex items-center justify-center rounded-full px-3 text-[13.5px] font-bold text-brand-600"
          >Skip</a
        >
      </div>

      {/*
        Two sizes, one per layout: the laptop card has no site header above it,
        and the phone screen has none either once the chrome is dropped.
      */}
      {/*
        Visibility lives on the wrapper, not on the Logo. The component sets its
        own `inline-flex`, and a `hidden` passed in alongside it is a coin toss
        decided by Tailwind's output order rather than by the caller.
      */}
      <span class="block pb-5 lg:hidden"><Logo size={52} /></span>
      <span class="hidden pb-5 lg:block"><Logo size={42} /></span>

      <div class="flex flex-1 flex-col lg:flex-none">
        <slot />
      </div>

      <div class="mt-8 flex gap-2 border-t border-line pt-4 text-center">
        <span class="flex-1 text-xs font-bold text-ink-muted">Cash on Delivery</span>
        <span class="w-px bg-line"></span>
        <span class="flex-1 text-xs font-bold text-ink-muted">7 din return</span>
        <span class="w-px bg-line"></span>
        <span class="flex-1 text-xs font-bold text-ink-muted">2–4 din delivery</span>
      </div>
    </div>
  </div>
</div>
