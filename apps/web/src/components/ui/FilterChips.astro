---
import {
  catalogueHref,
  formatPKRAmount,
  hasFilters,
  isUkSize,
  PRICE_CHIPS_PKR,
  SORT_LABELS,
  SORT_OPTIONS,
  sortUkSizes,
  type CatalogueQuery,
} from '@hamza/shared';

interface Props {
  basePath: string;
  query: CatalogueQuery;
  availableSizes: readonly string[];
}

const { basePath, query, availableSizes } = Astro.props;

/*
 * Every chip is a plain link, not a button.
 *
 * That makes a filtered view shareable, linkable and back-buttonable, and it
 * works with JavaScript disabled — which is the whole reason the storefront
 * ships almost none. The cost is a page load per tap; on Cloudflare's edge with
 * a cached catalogue that is cheaper than the JavaScript would have been.
 *
 * One horizontally-scrolling row on a phone, wrapping into rows from `sm:` up.
 * The mock's mobile category screen does exactly this: three stacked rows cost
 * ~350px before the first product, and a <details> disclosure fought Chrome's
 * `content-visibility` rules for no real gain.
 */
const sizes = sortUkSizes(availableSizes.filter(isUkSize));
const active = hasFilters(query);

const chip = (on: boolean) =>
  on ? 'bg-ink text-surface border-ink' : 'bg-surface text-ink border-line-strong hover:border-ink';

const base =
  'flex h-10 shrink-0 items-center whitespace-nowrap rounded-full border px-4 text-sm font-semibold';
---

<div class="-mx-4 overflow-x-auto px-4 sm:mx-0 sm:overflow-visible sm:px-0">
  <div class="flex w-max items-center gap-2 sm:w-auto sm:flex-wrap">
    <a
      href={catalogueHref(basePath, { q: query.q, sort: query.sort }, {})}
      class:list={[base, 'font-bold', chip(!active)]}
    >
      All
    </a>

    <a
      href={catalogueHref(basePath, query, { onSale: !query.onSale })}
      class:list={[
        base,
        'font-bold',
        query.onSale
          ? chip(true)
          : 'border-line-strong bg-surface text-brand-600 hover:border-brand-600',
      ]}
    >
      Sale
    </a>

    {
      PRICE_CHIPS_PKR.map((max) => (
        <a
          href={catalogueHref(basePath, query, {
            maxPricePkr: query.maxPricePkr === max ? undefined : max,
          })}
          class:list={[base, chip(query.maxPricePkr === max)]}
        >
          Under Rs {formatPKRAmount(max)}
        </a>
      ))
    }

    <span aria-hidden="true" class="h-6 w-px shrink-0 bg-line"></span>

    {
      SORT_OPTIONS.map((option) => (
        <a
          href={catalogueHref(basePath, query, { sort: option })}
          class:list={[base, 'text-[13px]', chip((query.sort ?? 'new') === option)]}
        >
          {SORT_LABELS[option]}
        </a>
      ))
    }
  </div>
</div>

{
  sizes.length > 0 && (
    <div class="-mx-4 mt-2.5 overflow-x-auto px-4 sm:mx-0 sm:overflow-visible sm:px-0">
      <div class="flex w-max items-center gap-2 sm:w-auto sm:flex-wrap">
        <span class="eyebrow shrink-0 pr-1">Size</span>
        {sizes.map((size) => (
          <a
            href={catalogueHref(basePath, query, {
              size: query.size === size ? undefined : size,
            })}
            class:list={[
              'flex h-9 min-w-10 shrink-0 items-center justify-center rounded-full border px-3 text-sm font-bold',
              chip(query.size === size),
            ]}
          >
            {size}
          </a>
        ))}
      </div>
    </div>
  )
}
