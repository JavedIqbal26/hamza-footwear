---
import { CATEGORIES, CATEGORY_LABELS, categoryPath } from '@hamza/shared';

interface Props {
  /** Overridden on the product page, where "sold out" is the likelier cause. */
  message?: string;
}

const {
  message = 'The page you are looking for has moved or is no longer available.',
} = Astro.props;
---

<div class="mx-auto max-w-3xl px-4 py-16 text-center">
  <p class="text-sm font-semibold uppercase tracking-wide text-brand-600">404</p>
  <h1 class="display text-[30px] sm:text-[38px]">
    Ye page mojood nahi hai
  </h1>
  <p class="mt-2 text-sm text-ink-muted">{message}</p>

  {/* Plain links here: the not-found page has no catalogue data to build tiles from. */}
  <ul class="mt-7 flex flex-wrap justify-center gap-2">
    {CATEGORIES.map((category) => (
      <li>
        <a
          href={categoryPath(category)}
          class="flex h-11 items-center rounded-full border border-line-strong bg-surface px-5 text-sm font-semibold text-ink hover:border-ink"
        >
          {CATEGORY_LABELS[category]}
        </a>
      </li>
    ))}
  </ul>

  <a
    href="/"
    class="tap-target mt-6 inline-flex items-center justify-center rounded-full bg-ink px-6 text-sm font-extrabold text-surface"
  >
    Go to home
  </a>
</div>
