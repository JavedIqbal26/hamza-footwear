---
import { formatPKR, type City } from '@hamza/shared';

import DeliveryFields from './DeliveryFields.astro';
import PaymentMethods from './PaymentMethods.astro';
import { TRUST } from '../../content/microcopy.js';
import type { WalletNumbers } from '../../lib/runtime.js';

interface Props {
  cities: readonly City[];
  wallets: WalletNumbers;
  subtotalPkr: number;
  /** Field-level messages from a rejected submit, keyed by field name. */
  errors?: Readonly<Record<string, string>>;
  /** What the customer already typed, so a rejected form is not wiped. */
  values?: Readonly<Record<string, string>>;
}

const { cities, wallets, subtotalPkr, errors = {}, values = {} } = Astro.props;

const value = (name: string): string => values[name] ?? '';
---

{/*
  `enctype` is required for the optional wallet screenshot in PaymentMethods —
  a urlencoded form sends the filename and silently drops the bytes.
*/}
<form
  method="POST"
  action="/checkout/submit"
  enctype="multipart/form-data"
  class="flex flex-col gap-7"
  novalidate
>
  <DeliveryFields cities={cities} errors={errors} values={values} />

  <PaymentMethods wallets={wallets} errors={errors} selected={value('payment_method')} />

  <div>
    <label for="notes" class="eyebrow">
      Note for us <span class="normal-case text-ink-soft">(optional)</span>
    </label>
    <textarea
      id="notes"
      name="notes"
      rows="2"
      class="mt-1.5 w-full rounded-xl border border-line-strong bg-surface px-3.5 py-3 text-base outline-none focus:border-ink"
      >{value('notes')}</textarea
    >
  </div>

  <div class="rounded-[16px] bg-brand-50 px-4 py-3.5">
    <p class="text-sm text-ink">{TRUST.cod}</p>
    <p class="mt-1 text-sm text-ink-muted">{TRUST.deliveryTime}</p>
  </div>

  <button
    type="submit"
    class="tap-target flex h-[56px] w-full items-center justify-center rounded-full bg-ink text-base font-extrabold text-surface"
  >
    Place order — {formatPKR(subtotalPkr)} + delivery
  </button>

  <p class="text-center text-xs text-ink-soft">
    Order karne ke baad hum aap ko call ya WhatsApp par confirm karenge.
  </p>
</form>
