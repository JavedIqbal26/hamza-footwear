---
import { formatPKR, PK_MOBILE_PATTERN, type City } from '@hamza/shared';

import PaymentMethods from './PaymentMethods.astro';
import { TRUST } from '../../content/microcopy.js';
import type { WalletNumbers } from '../../lib/runtime.js';

interface Props {
  cities: readonly City[];
  wallets: WalletNumbers;
  subtotalPkr: number;
  /** Field-level messages from a rejected submit, keyed by field name. */
  errors?: Readonly<Record<string, string>>;
  /** What the customer already typed, so a rejected form is not wiped. */
  values?: Readonly<Record<string, string>>;
}

const { cities, wallets, subtotalPkr, errors = {}, values = {} } = Astro.props;

/*
 * Field order is fixed by the brief and by how people actually recite an
 * address here: name -> mobile -> city -> area -> address. No postal code.
 */
const majorCities = cities.filter((city) => city.tier === 'major');
const otherCities = cities.filter((city) => city.tier !== 'major');

function value(name: string): string {
  return values[name] ?? '';
}
---

<form method="POST" action="/checkout/submit" class="space-y-6" novalidate>
  <fieldset class="space-y-4">
    <legend class="text-lg font-semibold text-ink">Delivery details</legend>

    <div>
      <label for="customer_name" class="block text-sm font-medium text-ink">
        Full name
      </label>
      <input
        id="customer_name"
        name="customer_name"
        type="text"
        required
        autocomplete="name"
        value={value('customer_name')}
        aria-invalid={errors.customer_name ? 'true' : undefined}
        aria-describedby={errors.customer_name ? 'error-customer_name' : undefined}
        class="tap-target mt-1 w-full rounded-lg border border-neutral-300 px-3 py-2.5 text-base"
      />
      {
        errors.customer_name && (
          <p id="error-customer_name" role="alert" class="mt-1 text-sm text-red-700">
            {errors.customer_name}
          </p>
        )
      }
    </div>

    <div>
      <label for="phone" class="block text-sm font-medium text-ink">
        Mobile number
      </label>
      {/*
        `inputmode="numeric"` brings up the number pad on Android. The pattern
        is the same one the server enforces — the browser is a convenience, the
        server is the authority.
      */}
      <input
        id="phone"
        name="phone"
        type="tel"
        required
        inputmode="numeric"
        autocomplete="tel"
        placeholder="03001234567"
        pattern={PK_MOBILE_PATTERN.source}
        value={value('phone')}
        aria-invalid={errors.phone ? 'true' : undefined}
        aria-describedby={errors.phone ? 'error-phone' : 'hint-phone'}
        class="tap-target mt-1 w-full rounded-lg border border-neutral-300 px-3 py-2.5 text-base"
      />
      {
        errors.phone ? (
          <p id="error-phone" role="alert" class="mt-1 text-sm text-red-700">
            {errors.phone}
          </p>
        ) : (
          <p id="hint-phone" class="mt-1 text-xs text-ink-muted">
            Is number par hum order confirm karenge
          </p>
        )
      }
    </div>

    <div>
      <label for="city" class="block text-sm font-medium text-ink">City</label>
      <select
        id="city"
        name="city"
        required
        aria-invalid={errors.city ? 'true' : undefined}
        class="tap-target mt-1 w-full rounded-lg border border-neutral-300 bg-white px-3 py-2.5 text-base"
      >
        <option value="">Choose your city</option>
        <optgroup label="Major cities">
          {
            majorCities.map((city) => (
              <option value={city.name} selected={value('city') === city.name}>
                {city.name} — {formatPKR(city.delivery_fee_pkr)} delivery
              </option>
            ))
          }
        </optgroup>
        <optgroup label="Rest of Pakistan">
          {
            otherCities.map((city) => (
              <option value={city.name} selected={value('city') === city.name}>
                {city.name} — {formatPKR(city.delivery_fee_pkr)} delivery
              </option>
            ))
          }
        </optgroup>
      </select>
      {
        errors.city && (
          <p role="alert" class="mt-1 text-sm text-red-700">
            {errors.city}
          </p>
        )
      }
    </div>

    <div>
      <label for="area" class="block text-sm font-medium text-ink">Area</label>
      <input
        id="area"
        name="area"
        type="text"
        required
        placeholder="e.g. Gulshan-e-Iqbal Block 5"
        value={value('area')}
        aria-invalid={errors.area ? 'true' : undefined}
        class="tap-target mt-1 w-full rounded-lg border border-neutral-300 px-3 py-2.5 text-base"
      />
      {
        errors.area && (
          <p role="alert" class="mt-1 text-sm text-red-700">
            {errors.area}
          </p>
        )
      }
    </div>

    <div>
      <label for="address_line" class="block text-sm font-medium text-ink">
        Full address
      </label>
      <textarea
        id="address_line"
        name="address_line"
        required
        rows="3"
        placeholder="House / flat number, street, nearby landmark"
        aria-invalid={errors.address_line ? 'true' : undefined}
        class="mt-1 w-full rounded-lg border border-neutral-300 px-3 py-2.5 text-base"
        >{value('address_line')}</textarea
      >
      {
        errors.address_line && (
          <p role="alert" class="mt-1 text-sm text-red-700">
            {errors.address_line}
          </p>
        )
      }
    </div>
  </fieldset>

  <PaymentMethods wallets={wallets} errors={errors} selected={value('payment_method')} />

  <div>
    <label for="notes" class="block text-sm font-medium text-ink">
      Note for us <span class="font-normal text-ink-muted">(optional)</span>
    </label>
    <textarea
      id="notes"
      name="notes"
      rows="2"
      class="mt-1 w-full rounded-lg border border-neutral-300 px-3 py-2.5 text-base"
      >{value('notes')}</textarea
    >
  </div>

  <div class="rounded-lg bg-brand-50 px-4 py-3">
    <p class="text-sm text-ink">{TRUST.cod}</p>
    <p class="mt-1 text-sm text-ink-muted">{TRUST.deliveryTime}</p>
  </div>

  <button
    type="submit"
    class="tap-target flex w-full items-center justify-center rounded-lg bg-brand-600 px-5 py-4 text-base font-semibold text-white"
  >
    Place order — {formatPKR(subtotalPkr)} + delivery
  </button>

  <p class="text-center text-xs text-ink-muted">
    Order karne ke baad hum aap ko call ya WhatsApp par confirm karenge.
  </p>
</form>
