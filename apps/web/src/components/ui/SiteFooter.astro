---
import { FOOTER_NAV, PRIMARY_NAV, SITE } from '../../lib/site.js';

const year = new Date().getFullYear();
---

<footer class="mt-16 border-t border-line bg-surface-sunk">
  <div class="mx-auto max-w-[1440px] px-4 py-10 sm:px-6">
    <div class="flex flex-wrap justify-between gap-x-12 gap-y-8">
      <div class="max-w-[34ch]">
        <p class="display text-2xl">{SITE.name}</p>
        <p class="mt-2 text-[13px] leading-relaxed text-ink-muted">{SITE.address}</p>
      </div>

      <div class="flex gap-12 sm:gap-14">
        <nav aria-label="Shop">
          <p class="eyebrow">Shop</p>
          <ul class="mt-3 space-y-2.5">
            {
              PRIMARY_NAV.map((link) => (
                <li>
                  <a class="text-sm text-ink hover:text-brand-600" href={link.href}>
                    {link.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>

        <nav aria-label="Help">
          <p class="eyebrow">Help</p>
          <ul class="mt-3 space-y-2.5">
            {
              FOOTER_NAV.map((link) => (
                <li>
                  <a class="text-sm text-ink hover:text-brand-600" href={link.href}>
                    {link.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </div>
    </div>

    <p class="mt-10 border-t border-line pt-6 text-xs text-ink-soft">
      &copy; {year} {SITE.name}. Prices in Pakistani Rupees.
    </p>
  </div>
</footer>
