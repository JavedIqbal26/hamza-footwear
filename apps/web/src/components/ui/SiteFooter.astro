---
import { FOOTER_NAV, PRIMARY_NAV, SITE } from '../../lib/site.js';
import { TRUST } from '../../content/microcopy.js';

const year = new Date().getFullYear();
---

<footer class="mt-16 border-t border-neutral-200 bg-neutral-50">
  <div class="mx-auto max-w-5xl px-4 py-10">
    <div class="grid gap-8 sm:grid-cols-3">
      <div>
        <p class="text-base font-bold text-brand-700">{SITE.name}</p>
        <p class="mt-1 text-sm text-ink-muted">{SITE.tagline}</p>
        <p class="mt-3 text-sm text-ink">{TRUST.deliveryTime}</p>
      </div>

      <nav aria-label="Shop">
        <h2 class="text-sm font-semibold text-ink">Shop</h2>
        <ul class="mt-2 space-y-1">
          {
            PRIMARY_NAV.map((link) => (
              <li>
                <a class="text-sm text-ink-muted hover:text-ink" href={link.href}>
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <nav aria-label="Help">
        <h2 class="text-sm font-semibold text-ink">Help</h2>
        <ul class="mt-2 space-y-1">
          {
            FOOTER_NAV.map((link) => (
              <li>
                <a class="text-sm text-ink-muted hover:text-ink" href={link.href}>
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>

    <p class="mt-8 border-t border-neutral-200 pt-6 text-xs text-ink-muted">
      &copy; {year} {SITE.name}. Prices in Pakistani Rupees.
    </p>
  </div>
</footer>
