---
import Icon from '../icons/Icon.astro';
import { buildWhatsAppContactLink } from '@hamza/shared';

import { TRUST } from '../../content/microcopy.js';
import { SITE } from '../../lib/site.js';

interface Props {
  shopPhone: string;
}

const { shopPhone } = Astro.props;

/*
 * One DOM tree, two layouts.
 *
 * On a phone the copy is overlaid on the photo as an inset card; from `lg:` up
 * it becomes a side-by-side split. An earlier version rendered two sections and
 * hid one, which put a second <h1> in the document and repeated the tagline for
 * crawlers. The copy block is first in source order, so the desktop grid places
 * it in column one with no reordering.
 *
 * ---------------------------------------------------------------------------
 * The photo is a STOCK IMAGE, self-hosted at `public/hero/`.
 *
 * Self-hosted, never hotlinked from images.unsplash.com: an off-origin fetch is
 * a reliability risk in Pakistan, and it is the LCP image on the busiest page.
 * Served as WebP at two widths — 74KB and 135KB — cropped 3:2 to match the box
 * so the browser never downloads pixels it will crop away.
 *
 * It is deliberately NOT a link and carries an empty alt: it sets the mood for
 * the shop, it is not merchandise. Linking a stock photo to a real product, or
 * describing it as one, would tell a customer they can buy shoes that are not
 * in the catalogue. Replace it with the owner's own storefront photography when
 * that exists — nothing else needs to change.
 * ---------------------------------------------------------------------------
 */
const whatsapp = buildWhatsAppContactLink(shopPhone);
---

<section
  class="relative mx-4 mt-4 h-[230px] overflow-hidden rounded-[18px] bg-surface-warm lg:mx-0 lg:mt-0 lg:grid lg:h-auto lg:min-h-[560px] lg:grid-cols-2 lg:rounded-none lg:border-b lg:border-line lg:bg-surface"
>
  {/* Copy — overlaid on the photo below lg, first column above it. */}
  <div
    class="absolute inset-x-0 bottom-0 z-10 flex flex-col items-start gap-2.5 p-4 lg:static lg:justify-center lg:gap-5 lg:p-8"
  >
    <span
      class="text-[10.5px] font-extrabold uppercase text-[#f0c9b8] lg:rounded-full lg:bg-brand-50 lg:px-3.5 lg:py-2 lg:text-xs lg:text-brand-600"
      style="letter-spacing: 0.13em;"
    >
      Naya stock — abhi live
    </span>

    <h1
      class="display max-w-[16ch] text-[30px] leading-[1.05] text-surface lg:max-w-[13ch] lg:text-[clamp(38px,5.4vw,76px)] lg:leading-none lg:tracking-[-0.02em] lg:text-ink"
    >
      {SITE.tagline}
    </h1>

    {/* The supporting sentence only earns its space once there is a column. */}
    <p class="hidden max-w-[42ch] text-[18px] leading-[1.55] text-ink-body lg:block">
      Khussa, everyday sneakers and school shoes — delivered anywhere in Pakistan
      in 2–4 days. Pay cash when you get them.
    </p>

    <div class="flex flex-wrap gap-3 lg:pt-1">
      <a
        href="/shop"
        class="flex h-11 items-center justify-center gap-1.5 rounded-full bg-surface px-5 text-sm font-extrabold text-ink lg:bg-brand-600 lg:px-6 lg:text-base lg:text-white lg:transition-colors lg:hover:bg-brand-700"
      >
        Shop new arrivals
        <Icon name="arrow-right" size={16} />
      </a>
      <a
        href={whatsapp}
        rel="noopener"
        class="hidden h-11 items-center gap-2 rounded-full border-[1.5px] border-ink px-6 text-base font-bold text-ink transition-colors hover:bg-ink hover:text-surface lg:flex"
      >
        {TRUST.whatsappPrompt}
      </a>
    </div>
  </div>

  {/* Photo — full-bleed behind the copy below lg, second column above it. */}
  <div class="absolute inset-0 lg:relative lg:overflow-hidden">
    <img
      src="/hero/storefront-1280.webp"
      srcset="/hero/storefront-800.webp 800w, /hero/storefront-1280.webp 1280w"
      sizes="(min-width: 1024px) 50vw, 100vw"
      alt=""
      width="1280"
      height="853"
      loading="eager"
      fetchpriority="high"
      decoding="async"
      class="absolute inset-0 h-full w-full object-cover"
    />

    {/* Dark wash keeps the overlaid copy legible; unnecessary once split. */}
    <div
      class="absolute inset-0 bg-gradient-to-t from-ink/90 via-ink/25 to-transparent lg:hidden"
      aria-hidden="true"
    >
    </div>

    {/*
      The caption plate.

      Sized and placed against a 560px photo, not a 420px one: at the old
      height it took a fifth of the frame and landed square on the subject,
      which read as a collision rather than a caption. The shadow does the rest
      of the work — it lifts the plate off the photograph so the overlap looks
      chosen.
    */}
    <span
      class="absolute bottom-7 left-7 hidden max-w-[290px] rounded-xl bg-surface/95 px-4 py-3.5 shadow-[0_18px_40px_-22px_rgba(23,18,15,0.65)] backdrop-blur lg:block"
    >
      <span class="eyebrow block text-brand-600">Handmade in Lahore</span>
      <span class="mt-1 block text-sm leading-relaxed text-ink-body">
        Leather uppers, stitched soles — not glued.
      </span>
    </span>
  </div>
</section>
