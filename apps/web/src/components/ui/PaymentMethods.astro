---
import { formatPhone } from '@hamza/shared';

import { TRUST } from '../../content/microcopy.js';
import type { WalletNumbers } from '../../lib/runtime.js';

interface Props {
  wallets: WalletNumbers;
  selected?: string;
  errors?: Readonly<Record<string, string>>;
}

const { wallets, selected = '', errors = {} } = Astro.props;

/*
 * Two payment models, not three wallets.
 *
 * The real choice a customer makes here is *when* they pay, not which app they
 * open:
 *
 * - **Cash on Delivery** — the delivery charge reaches the shop by wallet
 *   before the parcel ships; the shoes are paid for in cash at the door. The
 *   advance is what protects the shop from a refused delivery, which otherwise
 *   costs it the courier fee in both directions.
 * - **Full advance** — the whole amount by wallet, one transfer, nothing owed
 *   at the door.
 *
 * COD is listed first and preselected: it asks the least of a first-time buyer,
 * and most of this shop's traffic is first-time buyers arriving from TikTok.
 *
 * NOTHING IS PAID ON THIS PAGE. The delivery charge is quoted by the shop after
 * it sees the address, so neither amount is known yet. The transaction id and
 * screenshot fields that used to live here now sit on the order page, which is
 * the first moment either figure exists.
 *
 * A wallet is listed only if its number is configured. "Send money to (blank)"
 * would be worse than not offering it.
 */
const walletOptions = [
  { label: 'JazzCash', number: wallets.jazzcash },
  { label: 'Easypaisa', number: wallets.easypaisa },
].filter((option): option is typeof option & { number: string } => option.number !== null);

/* Both wallets are usually the same number; say it once when they are. */
const walletNumbers = [...new Set(walletOptions.map((option) => option.number))];
const walletNames = walletOptions.map((option) => option.label).join(' ya ');

const isSelected = (value: string): boolean =>
  selected === value || (selected === '' && value === 'cod');

const optionClass =
  'flex cursor-pointer gap-3 rounded-[16px] border border-line-strong p-4 transition-colors has-[:checked]:border-2 has-[:checked]:border-ink has-[:checked]:bg-brand-50';
---

<fieldset class="flex flex-col gap-3">
  <legend class="display text-[22px]">Payment</legend>

  <label class={optionClass}>
    <input
      type="radio"
      name="payment_method"
      value="cod"
      required
      checked={isSelected('cod')}
      class="mt-0.5 h-5 w-5 shrink-0 accent-ink"
    />
    <span>
      <span class="block text-sm font-extrabold text-ink">Cash on Delivery</span>
      <span class="mt-0.5 block text-sm text-ink-muted">{TRUST.cod}</span>
      <span class="mt-1 block text-xs text-ink-soft">{TRUST.codAdvance}</span>
    </span>
  </label>

  {
    walletOptions.length > 0 && (
      <label class={optionClass}>
        <input
          type="radio"
          name="payment_method"
          value={walletOptions[0]!.label.toLowerCase()}
          checked={walletOptions.some((option) => isSelected(option.label.toLowerCase()))}
          class="mt-0.5 h-5 w-5 shrink-0 accent-ink"
        />
        <span>
          <span class="block text-sm font-extrabold text-ink">Poora advance</span>
          <span class="mt-0.5 block text-sm text-ink-muted">
            {walletNames} par poori raqam bhejein — darwazay par kuch dena nahi.
          </span>
          <span class="mt-1 block text-xs text-ink-soft">
            Number:
            {walletNumbers.map((number) => (
              <strong class="font-extrabold text-ink">{formatPhone(number)}</strong>
            ))}
          </span>
        </span>
      </label>
    )
  }

  {/*
    Said once, plainly, for both options: the amount is not knowable yet. A
    customer who expects a total on this page and does not find one assumes the
    page is broken.
  */}
  <p class="rounded-xl bg-surface-sunk px-4 py-3 text-xs leading-relaxed text-ink-body">
    {TRUST.quotePending}
  </p>

  {
    errors.payment_method && (
      <p role="alert" class="text-sm text-brand-700">
        {errors.payment_method}
      </p>
    )
  }
</fieldset>
