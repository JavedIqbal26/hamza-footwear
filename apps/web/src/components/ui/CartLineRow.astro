---
import { formatPKR, primaryImage, productPath, MAX_QUANTITY_PER_LINE } from '@hamza/shared';

import ProductImage from './ProductImage.astro';
import type { PricedLine } from '../../lib/cart/pricing.js';

interface Props {
  line: PricedLine;
  returnTo: string;
}

const { line, returnTo } = Astro.props;
const { entry, product, unitPricePkr, lineTotalPkr } = line;

const quantities = Array.from({ length: MAX_QUANTITY_PER_LINE }, (_, i) => i + 1);
---

<li class="flex gap-4 border-b border-neutral-200 py-4">
  <a href={productPath(product.slug)} class="w-20 shrink-0 sm:w-24">
    <ProductImage
      baseKey={primaryImage(product)}
      alt={product.name}
      variant="thumb"
      sizes="96px"
      class="rounded-lg"
    />
  </a>

  <div class="min-w-0 flex-1">
    <a href={productPath(product.slug)} class="text-sm font-medium text-ink hover:underline">
      {product.name}
    </a>
    <p class="mt-0.5 text-xs text-ink-muted">
      Size UK {entry.size} &middot; {formatPKR(unitPricePkr)} each
    </p>

    <div class="mt-2 flex flex-wrap items-center gap-3">
      {/*
        A select plus a submit button, not a JavaScript stepper: changing the
        quantity is a real form post, so it works with no JavaScript. The submit
        button hides itself once the enhancement script takes over.
      */}
      <form method="POST" action="/cart/update" class="flex items-center gap-2" data-cart-qty>
        <input type="hidden" name="slug" value={product.slug} />
        <input type="hidden" name="size" value={entry.size} />
        <input type="hidden" name="return_to" value={returnTo} />

        <label class="sr-only" for={`qty-${product.slug}-${entry.size}`}>
          Quantity for {product.name}, size {entry.size}
        </label>
        <select
          id={`qty-${product.slug}-${entry.size}`}
          name="quantity"
          class="tap-target rounded-lg border border-neutral-300 px-2 text-sm"
        >
          {
            quantities.map((quantity) => (
              <option value={quantity} selected={quantity === entry.quantity}>
                {quantity}
              </option>
            ))
          }
        </select>

        <button
          type="submit"
          data-cart-qty-submit
          class="rounded border border-neutral-300 px-2 py-1 text-xs font-medium text-ink-muted"
        >
          Update
        </button>
      </form>

      <form method="POST" action="/cart/update">
        <input type="hidden" name="slug" value={product.slug} />
        <input type="hidden" name="size" value={entry.size} />
        <input type="hidden" name="action" value="remove" />
        <input type="hidden" name="return_to" value={returnTo} />
        <button type="submit" class="text-xs font-medium text-red-700 underline">
          Remove
        </button>
      </form>
    </div>
  </div>

  <p class="shrink-0 text-sm font-semibold text-ink">{formatPKR(lineTotalPkr)}</p>
</li>
