---
import type { Product } from '@hamza/shared';

import ProductCard from './ProductCard.astro';

interface Props {
  products: readonly Product[];
  videoRef?: string | null;
  /** Shown when the category is empty rather than rendering a bare page. */
  emptyMessage?: string;
}

const {
  products,
  videoRef = null,
  emptyMessage = 'Naye design jald aa rahe hain.',
} = Astro.props;

/** Only the first row is above the fold on a phone; the rest load lazily. */
const EAGER_COUNT = 2;
---

{
  products.length === 0 ? (
    <p class="rounded-lg bg-neutral-50 px-4 py-10 text-center text-sm text-ink-muted">
      {emptyMessage}
    </p>
  ) : (
    <ul class="grid grid-cols-2 gap-x-4 gap-y-8 sm:grid-cols-3 lg:grid-cols-4">
      {products.map((product, index) => (
        <li>
          <ProductCard
            product={product}
            videoRef={videoRef}
            eager={index < EAGER_COUNT}
          />
        </li>
      ))}
    </ul>
  )
}
