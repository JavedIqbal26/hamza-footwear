---
import { formatRating, hasRating, starStates, type RatingSummary, type Review } from '@hamza/shared';

interface Props {
  rating: RatingSummary;
  reviews: readonly Review[];
  /** Set when the signed-in customer has a delivered order and has not reviewed yet. */
  canReview: boolean;
  productId: string;
  returnTo: string;
}

const { rating, reviews, canReview, productId, returnTo } = Astro.props;

const stars = starStates(rating);

function initials(name: string): string {
  const trimmed = name.trim();
  return trimmed ? trimmed.slice(0, 1).toUpperCase() : '·';
}

function shortDate(iso: string): string {
  const date = new Date(iso);
  return Number.isNaN(date.getTime())
    ? ''
    : date.toLocaleDateString('en-GB', { month: 'short', year: 'numeric' });
}
---

<section class="mx-auto max-w-5xl px-4 pt-14 sm:px-6">
  <h2 class="display text-[26px] sm:text-[30px]">Reviews</h2>

  {
    hasRating(rating) ? (
      <div class="mt-3 flex items-baseline gap-3">
        <span class="text-[32px] font-extrabold leading-none">{formatRating(rating)}</span>
        <span class="flex gap-0.5 text-lg text-brand-600" aria-hidden="true">
          {stars.map((state) => (
            <span>{state === 'full' ? '★' : state === 'half' ? '⯪' : '☆'}</span>
          ))}
        </span>
        <span class="text-sm text-ink-muted">
          {rating.count} {rating.count === 1 ? 'review' : 'reviews'}
        </span>
      </div>
    ) : (
      <p class="mt-2 text-sm text-ink-muted">
        Is joote par abhi tak koi review nahi.
      </p>
    )
  }

  {/*
    Only a customer with a delivered order containing this product can write a
    review, and only once. An unverifiable star average is worse than none —
    it is the number a hesitant COD buyer leans on hardest.
  */}
  {
    canReview && (
      <form
        method="POST"
        action="/reviews/submit"
        class="mt-6 flex flex-col gap-4 rounded-[16px] border border-line p-4"
      >
        <input type="hidden" name="product_id" value={productId} />
        <input type="hidden" name="return_to" value={returnTo} />

        <p class="text-sm font-extrabold">Aap ne ye khareeda hai — review likhein</p>

        <fieldset class="flex flex-col gap-2">
          <legend class="eyebrow">Rating</legend>
          <div class="flex gap-2">
            {[1, 2, 3, 4, 5].map((value) => (
              <label class="cursor-pointer">
                <input type="radio" name="rating" value={value} required class="peer sr-only" />
                <span class="flex h-11 w-11 items-center justify-center rounded-xl border border-line-strong text-base font-bold peer-checked:border-2 peer-checked:border-ink peer-focus-visible:outline-2 peer-focus-visible:outline-offset-2 peer-focus-visible:outline-brand-600">
                  {value}
                </span>
              </label>
            ))}
          </div>
        </fieldset>

        <div>
          <label for="review-body" class="eyebrow">
            Aap ka tajurba <span class="normal-case">(optional)</span>
          </label>
          <textarea
            id="review-body"
            name="body"
            rows="3"
            maxlength="1000"
            class="mt-1.5 w-full rounded-xl border border-line-strong px-3 py-2.5 text-base"
          />
        </div>

        <button
          type="submit"
          class="tap-target flex items-center justify-center rounded-full bg-ink px-5 text-sm font-extrabold text-surface"
        >
          Review bhejein
        </button>
      </form>
    )
  }

  {
    reviews.length > 0 && (
      <ul class="mt-6 divide-y divide-line">
        {reviews.map((review) => (
          <li class="flex gap-3 py-4">
            <span
              aria-hidden="true"
              class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-surface-fill text-sm font-extrabold text-ink-muted"
            >
              {initials(review.author_name)}
            </span>
            <div class="min-w-0 flex-1">
              <div class="flex flex-wrap items-baseline gap-x-3">
                <span class="text-sm font-bold">{review.author_name || 'Customer'}</span>
                <span class="text-[13px] text-brand-600" aria-label={`${review.rating} out of 5`}>
                  {'★'.repeat(review.rating)}
                  <span class="text-ink-disabled">{'★'.repeat(5 - review.rating)}</span>
                </span>
                <span class="text-xs text-ink-soft">{shortDate(review.created_at)}</span>
              </div>
              {review.body && (
                <p class="mt-1 whitespace-pre-line text-[13.5px] leading-relaxed text-ink-body">
                  {review.body}
                </p>
              )}
            </div>
          </li>
        ))}
      </ul>
    )
  }
</section>
