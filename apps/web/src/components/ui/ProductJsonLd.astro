---
import {
  effectivePricePkr,
  hasRating,
  imageUrl,
  isOrderable,
  NO_RATING,
  type Product,
  type RatingSummary,
} from '@hamza/shared';

import { SITE } from '../../lib/site.js';

interface Props {
  product: Product;
  url: string;
  rating?: RatingSummary;
}

const { product, url, rating = NO_RATING } = Astro.props;

/**
 * Product structured data.
 *
 * Costs nothing at runtime (it is data, not JavaScript) and is what lets a
 * shared link render as a product card rather than a bare URL.
 *
 * `aggregateRating` is included only when real reviews exist — inventing one
 * is both a lie to shoppers and a manual action from Google.
 */
const jsonLd: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: product.name,
  description: product.description,
  sku: product.id,
  image: product.images.map((key) => new URL(imageUrl(key, 'full'), SITE.url).href),
  brand: { '@type': 'Brand', name: SITE.name },
  offers: {
    '@type': 'Offer',
    url,
    priceCurrency: 'PKR',
    price: String(effectivePricePkr(product)),
    availability: isOrderable(product.stock_status)
      ? 'https://schema.org/InStock'
      : 'https://schema.org/OutOfStock',
  },
};

if (hasRating(rating)) {
  jsonLd.aggregateRating = {
    '@type': 'AggregateRating',
    ratingValue: rating.average.toFixed(1),
    reviewCount: rating.count,
  };
}
---

<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />
