---
import { footLengthCm, formatPKR, productPath, type UkSize } from '@hamza/shared';

import { TRUST } from '../../content/microcopy.js';

interface Props {
  slug: string;
  sizes: readonly UkSize[];
  pricePkr: number;
  /** Preselects the size the customer arrived with, or the one on their account. */
  selectedSize?: UkSize | null;
  showSizeError?: boolean;
}

const { slug, sizes, pricePkr, selectedSize = null, showSizeError = false } = Astro.props;

/*
 * A real form posting to a real endpoint: add-to-cart works with JavaScript
 * disabled. `required` on the radios means the browser itself blocks a submit
 * with no size chosen, so the error below is only for no-JS clients.
 *
 * The submit button is inside the sticky bottom bar in the design, so the form
 * wraps both the size tiles and that bar — one form, two visually separate
 * regions, no JavaScript needed to connect them.
 */
---

<form method="POST" action="/cart/add" data-size-selector>
  <input type="hidden" name="slug" value={slug} />
  <input type="hidden" name="return_to" value={productPath(slug)} />

  <fieldset class="flex flex-col gap-2.5">
    <div class="flex items-baseline justify-between gap-3">
      <legend class="text-sm font-extrabold">Size (UK)</legend>
      <a
        href="/size-guide"
        class="-my-2 inline-flex min-h-11 items-center text-[13px] font-bold text-brand-600"
      >
        Size guide
      </a>
    </div>

    <div class="flex flex-wrap gap-2">
      {
        sizes.map((size) => (
          <label class="cursor-pointer">
            <input
              type="radio"
              name="size"
              value={size}
              required
              checked={size === selectedSize}
              class="peer sr-only"
              data-foot-cm={String(footLengthCm(size))}
            />
            <span class="flex h-[46px] min-w-[52px] items-center justify-center rounded-xl border border-line-strong px-3 text-[15px] font-bold text-ink transition-colors peer-checked:border-2 peer-checked:border-ink peer-checked:font-extrabold peer-focus-visible:outline-2 peer-focus-visible:outline-offset-2 peer-focus-visible:outline-brand-600">
              {size}
            </span>
          </label>
        ))
      }
    </div>

    {
      showSizeError && (
        <p role="alert" class="text-sm font-bold text-brand-700">
          Pehle size chunein.
        </p>
      )
    }

    <p class="text-xs text-ink-muted">
      {TRUST.sizeUk}. <span data-selected-size-hint>{TRUST.sizeHelp}</span>
    </p>
  </fieldset>

  {/*
    The order action never leaves the bottom of the screen — the single most
    important structural idea in the design's product screen.
  */}
  <div
    class="sticky bottom-0 z-20 -mx-4 mt-8 flex items-center gap-2.5 bg-ink px-4 py-3.5 pb-[max(0.875rem,env(safe-area-inset-bottom))] sm:mx-0 sm:rounded-2xl"
  >
    <button
      type="submit"
      class="flex h-[52px] flex-1 items-center justify-center rounded-full bg-surface text-[15px] font-extrabold text-ink"
    >
      Add to cart · {formatPKR(pricePkr)}
    </button>
    <slot name="whatsapp" />
  </div>
</form>

<script>
  import { initSizeSelector } from '../../scripts/size-selector.js';

  initSizeSelector();
</script>
