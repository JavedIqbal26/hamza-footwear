---
import { footLengthCm, productPath, type UkSize } from '@hamza/shared';

import { TRUST } from '../../content/microcopy.js';

interface Props {
  slug: string;
  sizes: readonly UkSize[];
  /** Preselects the size when the customer arrived with one already chosen. */
  selectedSize?: UkSize | null;
  /** Set when the customer submitted without picking a size. */
  showSizeError?: boolean;
}

const { slug, sizes, selectedSize = null, showSizeError = false } = Astro.props;

/*
 * A real form posting to a real endpoint: add-to-cart works with JavaScript
 * disabled. `required` on the radios means the browser itself blocks a submit
 * with no size chosen, so the size error below is only for no-JS clients.
 */
---

<form
  method="POST"
  action="/cart/add"
  data-size-selector
  class="space-y-4"
>
  <input type="hidden" name="slug" value={slug} />
  <input type="hidden" name="return_to" value={productPath(slug)} />

  <fieldset class="space-y-3">
    <div class="flex items-baseline justify-between gap-3">
      <legend class="text-sm font-semibold text-ink">Select size (UK)</legend>
      <a href="/size-guide" class="text-sm font-medium text-brand-600 underline">
        Size guide
      </a>
    </div>

    <div class="flex flex-wrap gap-2">
      {
        sizes.map((size) => (
          <label class="cursor-pointer">
            <input
              type="radio"
              name="size"
              value={size}
              required
              checked={size === selectedSize}
              class="peer sr-only"
              data-foot-cm={String(footLengthCm(size))}
            />
            <span class="tap-target flex items-center justify-center rounded-lg border border-neutral-300 px-3 text-sm font-medium text-ink transition-colors peer-checked:border-brand-600 peer-checked:bg-brand-600 peer-checked:text-white peer-focus-visible:outline-2 peer-focus-visible:outline-offset-2 peer-focus-visible:outline-brand-600">
              {size}
            </span>
          </label>
        ))
      }
    </div>

    {
      showSizeError && (
        <p role="alert" class="text-sm font-medium text-red-700">
          Pehle size chunein.
        </p>
      )
    }

    <p class="text-xs text-ink-muted">
      {TRUST.sizeUk}. <span data-selected-size-hint>{TRUST.sizeHelp}</span>
    </p>
  </fieldset>

  <button
    type="submit"
    class="tap-target flex w-full items-center justify-center rounded-lg bg-brand-600 px-5 py-3.5 text-base font-semibold text-white transition-colors hover:bg-brand-700"
  >
    Add to cart
  </button>
</form>

<script>
  import { initSizeSelector } from '../../scripts/size-selector.js';

  initSizeSelector();
</script>
