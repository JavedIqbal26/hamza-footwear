---
import { imageSrcSet, imageUrl } from '@hamza/shared';

import ProductImage from '../ui/ProductImage.astro';

interface Props {
  images: readonly string[];
  productName: string;
}

const { images, productName } = Astro.props;
const [firstImage, ...rest] = images;
const hasMore = rest.length > 0;
---

<div data-gallery class="relative">
  <div class="overflow-hidden bg-photo sm:rounded-[18px]">
    <ProductImage
      baseKey={firstImage ?? null}
      alt={productName}
      variant="product"
      sizes="(min-width: 1024px) 560px, 100vw"
      loading="eager"
    />
  </div>

  {/*
    Dot indicators, as in the design: on a phone the thumbnails below are the
    control, and the dots are what tell you there is more than one photo at all.
  */}
  {
    hasMore && (
      <div
        data-gallery-dots
        aria-hidden="true"
        class="pointer-events-none absolute inset-x-0 bottom-3 flex justify-center gap-1.5"
      >
        {images.map((_, index) => (
          <span
            data-gallery-dot
            class:list={[
              'h-1 rounded-full transition-all',
              index === 0 ? 'w-5 bg-ink' : 'w-2 bg-ink/25',
            ]}
          />
        ))}
      </div>
    )
  }

  {
    hasMore && (
      <ul class="mt-3 grid grid-cols-4 gap-2">
        {images.map((baseKey, index) => (
          <li>
            <button
              type="button"
              data-gallery-thumb
              data-full-src={imageUrl(baseKey, 'product')}
              data-full-srcset={imageSrcSet(baseKey)}
              aria-label={`Show image ${index + 1} of ${images.length}`}
              aria-current={index === 0 ? 'true' : 'false'}
              class="block w-full overflow-hidden rounded-xl border-2 border-transparent aria-[current=true]:border-brand-600"
            >
              <ProductImage baseKey={baseKey} alt="" variant="thumb" sizes="25vw" loading="lazy" />
            </button>
          </li>
        ))}
      </ul>
    )
  }
</div>

<script>
  import { initGallery } from '../../scripts/gallery.js';

  initGallery();
</script>
