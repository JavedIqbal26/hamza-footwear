---
import Icon from '../../components/icons/Icon.astro';
import { createOrderRepository } from '@hamza/db';
import {
  buildWhatsAppContactLink,
  formatPKR,
  formatPhone,
  ORDER_STATUS_LABELS,
  PAYMENT_METHOD_LABELS,
} from '@hamza/shared';

import BaseLayout from '../../layouts/BaseLayout.astro';
import NotFound from '../../components/ui/NotFound.astro';
import { TRUST } from '../../content/microcopy.js';
import { NO_STORE } from '../../lib/cache.js';
import { currentCustomer } from '../../lib/auth/session.js';
import { getDatabase, getShopWhatsApp } from '../../lib/runtime.js';

export const prerender = false;

/**
 * Order confirmation and tracking.
 *
 * Addressed by the order's UUID rather than its human-readable number: the
 * number is sequential, so a guessable URL would expose every customer's name,
 * phone and address to anyone counting upwards.
 */
const { id } = Astro.params;
const order = id ? await createOrderRepository(getDatabase(Astro.locals)).findById(id) : null;

if (order === null) Astro.response.status = 404;

/* Contains personal data. Never cached, never indexed. */
Astro.response.headers.set('Cache-Control', NO_STORE);

const shopPhone = getShopWhatsApp(Astro.locals);
const customer = await currentCustomer(Astro.locals, Astro.cookies);
const isMine = Boolean(order && customer && order.customer_id === customer.id);
---

{
  order === null ? (
    <BaseLayout title="Order not found" noindex shopPhone={shopPhone}>
      <NotFound message="We could not find that order. If you have just placed one, please check the link we sent you." />
    </BaseLayout>
  ) : (
    <BaseLayout title={`Order ${order.order_number}`} noindex shopPhone={shopPhone}>
      <div class="mx-auto max-w-2xl px-4 pt-10 sm:px-6">
        <div class="rounded-[18px] bg-brand-50 px-5 py-8 text-center">
          <p class="eyebrow">Shukriya!</p>
          <h1 class="display mt-1 text-[32px]">Order {order.order_number}</h1>
          <p class="mt-2 text-sm text-ink">
            Hum aap ko is number par confirm karenge: {formatPhone(order.phone)}
          </p>
          <p class="mt-3 inline-flex rounded-full bg-ink px-4 py-1.5 text-xs font-extrabold text-surface">
            {ORDER_STATUS_LABELS[order.order_status]}
          </p>
        </div>

        <section class="mt-8">
          <h2 class="text-sm font-extrabold">Your order</h2>
          <ul class="mt-2 divide-y divide-line border-y border-line">
            {order.items.map((item) => (
              <li class="flex justify-between gap-4 py-3 text-sm">
                <span class="text-ink">
                  {item.quantity} &times; {item.name}
                  <span class="text-ink-soft"> (UK {item.size})</span>
                </span>
                <span class="shrink-0 font-bold text-ink">
                  {formatPKR(item.unit_price_pkr * item.quantity)}
                </span>
              </li>
            ))}
          </ul>

          <dl class="mt-4 space-y-1.5 text-sm">
            <div class="flex justify-between">
              <dt class="text-ink-muted">Subtotal</dt>
              <dd class="text-ink">{formatPKR(order.subtotal_pkr)}</dd>
            </div>
            <div class="flex justify-between">
              <dt class="text-ink-muted">Delivery to {order.city}</dt>
              <dd class="text-ink">{formatPKR(order.delivery_fee_pkr)}</dd>
            </div>
            <div class="flex justify-between border-t border-line pt-2.5">
              <dt class="font-extrabold text-ink">Total</dt>
              <dd class="text-xl font-extrabold text-ink">{formatPKR(order.total_pkr)}</dd>
            </div>
          </dl>

          <p class="mt-3 text-sm text-ink-muted">
            Payment: {PAYMENT_METHOD_LABELS[order.payment_method]}
          </p>
        </section>

        <section class="mt-8">
          <h2 class="text-sm font-extrabold">Delivery address</h2>
          <address class="mt-1.5 text-sm not-italic leading-relaxed text-ink-muted">
            {order.customer_name}
            <br />
            {order.address_line}
            <br />
            {order.area}, {order.city}
          </address>
        </section>

        <p class="mt-8 rounded-[16px] bg-surface-sunk px-4 py-3.5 text-sm text-ink">
          {TRUST.deliveryTime}
        </p>

        <a
          href={buildWhatsAppContactLink(shopPhone)}
          rel="noopener"
          class="tap-target mt-4 flex h-[54px] w-full items-center justify-center gap-2 rounded-full bg-whatsapp text-base font-extrabold text-whatsapp-ink"
        >
          <Icon name="whatsapp" size={20} />
          WhatsApp par rabta karein
        </a>

        {/*
          Only offered when this order belongs to the signed-in account —
          otherwise the link is an invitation to an empty page.
        */}
        {isMine && (
          <a href="/account" class="mt-3 block text-center text-sm font-bold text-brand-600">
            All your orders →
          </a>
        )}

        <a href="/shop" class="mt-3 block text-center text-sm font-bold text-brand-600">
          Continue shopping
        </a>
      </div>
    </BaseLayout>
  )
}
