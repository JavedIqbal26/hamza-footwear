---
import { buildWhatsAppContactLink, readVideoRef } from '@hamza/shared';

import BaseLayout from '../layouts/BaseLayout.astro';
import CategoryTiles from '../components/ui/CategoryTiles.astro';
import ProductGrid from '../components/ui/ProductGrid.astro';
import HomeHero from '../components/ui/HomeHero.astro';
import TrustStrip from '../components/ui/TrustStrip.astro';
import { TRUST } from '../content/microcopy.js';
import { listCategoryTiles, listFeaturedProducts, ratingsFor } from '../lib/catalogue.js';
import { CATALOGUE_CACHE_CONTROL } from '../lib/cache.js';
import { getShopWhatsApp } from '../lib/runtime.js';
import { readWishlist } from '../lib/wishlist/session.js';
import { SITE } from '../lib/site.js';

/* Reads the catalogue from D1, so it renders on demand rather than at build. */
export const prerender = false;

const products = await listFeaturedProducts(Astro.locals);
const [ratings, categoryTiles] = await Promise.all([
  ratingsFor(Astro.locals, products),
  listCategoryTiles(Astro.locals),
]);
const videoRef = readVideoRef(Astro.url.searchParams);
const saved = readWishlist(Astro.cookies);
const shopPhone = getShopWhatsApp(Astro.locals);

Astro.response.headers.set('Cache-Control', CATALOGUE_CACHE_CONTROL);
---

<BaseLayout title={SITE.name} description={SITE.description} shopPhone={shopPhone}>
  <HomeHero shopPhone={shopPhone} />

  {/*
    Desktop only. On a phone the header chip row is the category navigation —
    repeating it here just pushed the products off the first screen, which is
    the whole thing the design gets right.
  */}
  <section class="hidden px-4 pt-8 sm:px-6 lg:block">
    <h2 class="display text-[26px] sm:text-[34px]">Shop by category</h2>
    <div class="mt-5">
      <CategoryTiles tiles={categoryTiles} />
    </div>
  </section>

  <section class="px-4 pt-7 sm:px-6 lg:pt-12">
    <div class="flex items-baseline justify-between gap-4">
      <h2 class="display text-[26px] sm:text-[34px]">New arrivals</h2>
      <a
        href="/shop"
        class="-my-2 -mr-2 inline-flex min-h-11 items-center px-2 text-sm font-bold text-brand-600"
        >See all →</a
      >
    </div>
    <div class="mt-5">
      <ProductGrid
        products={products}
        ratings={ratings}
        saved={saved}
        shopPhone={shopPhone}
        videoRef={videoRef}
        returnTo="/"
      />
    </div>
  </section>

  <section class="px-4 pt-12 sm:px-6">
    <div
      class="grid gap-7 rounded-[18px] bg-ink px-5 py-8 text-[#f4ece0] sm:px-10 sm:py-11 lg:grid-cols-2 lg:items-center"
    >
      <div>
        <h2 class="display text-[26px] text-surface sm:text-[38px]">
          {TRUST.whatsappSizeTitle} WhatsApp par poochein.
        </h2>
        <p class="mt-3 max-w-[62ch] text-[15px] leading-relaxed text-[#c9bcab] sm:text-[17px]">
          Apne current joote ki tasveer bhejein aur hum dispatch se pehle sahi size
          confirm kar denge.
        </p>
      </div>
      <div class="flex flex-col gap-2.5">
        <a
          href={buildWhatsAppContactLink(shopPhone)}
          rel="noopener"
          class="tap-target flex items-center justify-center rounded-full bg-whatsapp px-7 text-base font-extrabold text-whatsapp-ink hover:brightness-95"
        >
          {TRUST.whatsappPrompt}
        </a>
        <span class="text-center text-[13px] text-ink-on-ink">Ya call karein — same number</span>
      </div>
    </div>
  </section>

  <TrustStrip />
</BaseLayout>
