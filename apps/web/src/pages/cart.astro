---
import { formatPKR } from '@hamza/shared';

import BaseLayout from '../layouts/BaseLayout.astro';
import CartLineRow from '../components/ui/CartLineRow.astro';
import { TRUST } from '../content/microcopy.js';
import { priceCart, survivingCart } from '../lib/cart/pricing.js';
import { readCart, writeCart } from '../lib/cart/session.js';
import { NO_STORE } from '../lib/cache.js';

export const prerender = false;

const priced = await priceCart(Astro.locals, readCart(Astro.cookies));

/*
 * Pricing may have dropped lines that sold out or lost a size since the customer
 * added them. Write the surviving cart straight back, so the cookie and what is
 * on screen never disagree.
 */
if (priced.changed) {
  writeCart(Astro.cookies, survivingCart(priced));
}

/* A cart is personal and changes constantly — it must never be cached. */
Astro.response.headers.set('Cache-Control', NO_STORE);

const REMOVAL_REASONS = {
  unavailable: 'is no longer available',
  out_of_stock: 'is out of stock',
  size_unavailable: 'is not available in that size any more',
} as const;
---

<BaseLayout title="Your Cart" noindex>
  <div class="mx-auto max-w-3xl px-4 pt-8">
    <h1 class="text-2xl font-bold tracking-tight text-ink">Your Cart</h1>

    {
      priced.removed.length > 0 && (
        <div role="alert" class="mt-4 rounded-lg bg-amber-50 px-4 py-3 text-sm text-amber-900">
          <p class="font-semibold">Some items changed</p>
          <ul class="mt-1 space-y-0.5">
            {priced.removed.map((removed) => (
              <li>
                {removed.name} {REMOVAL_REASONS[removed.reason]}, so we removed it.
              </li>
            ))}
          </ul>
        </div>
      )
    }

    {
      priced.lines.length === 0 ? (
        <div class="mt-8 rounded-lg bg-neutral-50 px-4 py-12 text-center">
          <p class="text-sm text-ink-muted">Aap ka cart khali hai.</p>
          <a
            href="/shop"
            class="tap-target mt-4 inline-flex items-center justify-center rounded-lg bg-brand-600 px-5 py-3 text-sm font-semibold text-white"
          >
            Start shopping
          </a>
        </div>
      ) : (
        <>
          <ul class="mt-4">
            {priced.lines.map((line) => (
              <CartLineRow line={line} returnTo="/cart" />
            ))}
          </ul>

          <div class="mt-6 rounded-lg bg-neutral-50 px-4 py-4">
            <div class="flex items-baseline justify-between">
              <p class="text-sm text-ink-muted">Subtotal</p>
              <p class="text-lg font-bold text-ink">{formatPKR(priced.subtotalPkr)}</p>
            </div>
            <p class="mt-1 text-xs text-ink-muted">{TRUST.deliveryFeeNote}</p>
          </div>

          <a
            href="/checkout"
            class="tap-target mt-4 flex w-full items-center justify-center rounded-lg bg-brand-600 px-5 py-3.5 text-base font-semibold text-white"
          >
            Checkout
          </a>

          <a href="/shop" class="mt-3 block text-center text-sm text-brand-600 underline">
            Continue shopping
          </a>
        </>
      )
    }
  </div>
</BaseLayout>

<script>
  import { initCartQuantity } from '../scripts/cart-quantity.js';

  initCartQuantity();
</script>
