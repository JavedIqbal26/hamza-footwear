---
import BaseLayout from '../layouts/BaseLayout.astro';
import { TRUST } from '../content/microcopy.js';

export const prerender = true;

/*
 * The shop's actual policy, which is more generous than most and worth stating
 * plainly: seven days, return or exchange, refund by wallet.
 *
 * The one thing this page must not do is imply the exchange is free. It is not
 * — the customer pays the courier in both directions, and finding that out
 * after posting a parcel back is exactly the sort of surprise that turns a size
 * problem into an argument. So the cost condition is a condition, in the list,
 * not a footnote at the bottom.
 */
const CONDITIONS = [
  'Joota bilkul naya ho — pehna hua na ho',
  'Original box aur packing saath ho',
  'Order ke 7 din ke andar batayein',
  'Aane jaane ka courier kharcha customer ka hota hai',
] as const;
---

<BaseLayout
  title="Returns & Exchange"
  description="Return or exchange your Hamza Footwear order within 7 days, in original condition."
>
  <div class="mx-auto max-w-3xl px-4 pt-8">
    <h1 class="display text-[30px] sm:text-[38px]">Returns &amp; Exchange</h1>

    <p class="mt-4 rounded-xl bg-brand-50 px-4 py-3 text-sm font-medium text-ink">
      {TRUST.returns}
    </p>

    <section class="mt-8">
      <h2 class="display text-[22px]">Conditions</h2>
      <ul class="mt-3 space-y-2">
        {
          CONDITIONS.map((condition) => (
            <li class="flex gap-2 text-sm text-ink">
              <span aria-hidden="true" class="text-brand-600">
                &bull;
              </span>
              <span>{condition}</span>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="mt-8">
      <h2 class="display text-[22px]">Size badalna ho to</h2>
      <ol class="mt-3 list-decimal space-y-2 pl-5 text-sm text-ink">
        <li>WhatsApp par humein apna order number aur naya size batayein.</li>
        <li>Hum aap ko courier ki tafseel bhej dete hain.</li>
        <li>Purana joota milne ke baad naya size bhej diya jata hai.</li>
      </ol>
    </section>

    <section class="mt-8">
      <h2 class="display text-[22px]">Paisay wapas</h2>
      <p class="mt-2 text-sm leading-relaxed text-ink">
        Joota asli halat mein wapas milne ke baad, shoes ke paisay usi JazzCash ya
        Easypaisa number par wapas bhej diye jate hain. Delivery charge wapas nahi
        hota — woh courier ne le liya hota hai.
      </p>
    </section>

    <section class="mt-8">
      <h2 class="display text-[22px]">Avoiding an exchange</h2>
      <p class="mt-2 text-sm text-ink-muted">
        Most exchanges happen because of size, and the courier both ways costs more
        than the two minutes it takes to measure. Check the <a
          href="/size-guide"
          class="font-medium text-brand-600 underline">size guide</a
        > first.
      </p>
    </section>
  </div>
</BaseLayout>
