---
import { CATEGORY_LABELS, categoryPath, isCategory } from '@hamza/shared';

import BaseLayout from '../layouts/BaseLayout.astro';
import CatalogueView from '../components/ui/CatalogueView.astro';
import NotFound from '../components/ui/NotFound.astro';
import { browseCatalogue, parseCatalogueQuery } from '../lib/catalogue.js';
import { CATALOGUE_CACHE_CONTROL, NO_STORE } from '../lib/cache.js';
import { getShopWhatsApp } from '../lib/runtime.js';
import { readWishlist } from '../lib/wishlist/session.js';

export const prerender = false;

/*
 * This route sits at the site root, so it also catches every unknown top-level
 * path. Anything that is not a real category renders the not-found page with a
 * real 404 status — no redirect hop, and no empty grid pretending to be a page.
 */
const raw = Astro.params.category;
const category = raw && isCategory(raw) ? raw : null;

const query = { ...parseCatalogueQuery(Astro.url.searchParams), category: category ?? undefined };
const view = category ? await browseCatalogue(Astro.locals, query) : null;
const saved = readWishlist(Astro.cookies);
const shopPhone = getShopWhatsApp(Astro.locals);

if (category === null) {
  Astro.response.status = 404;
  Astro.response.headers.set('Cache-Control', NO_STORE);
} else {
  Astro.response.headers.set('Cache-Control', CATALOGUE_CACHE_CONTROL);
}

const label = category ? CATEGORY_LABELS[category] : '';
---

{
  category === null || view === null ? (
    <BaseLayout title="Page not found" noindex shopPhone={shopPhone}>
      <NotFound />
    </BaseLayout>
  ) : (
    <BaseLayout
      title={`${label}'s Shoes`}
      description={`${label}'s shoes delivered across Pakistan. Cash on Delivery available.`}
      shopPhone={shopPhone}
    >
      <CatalogueView
        heading={label}
        basePath={categoryPath(category)}
        query={query}
        view={view}
        saved={saved}
      />
    </BaseLayout>
  )
}
