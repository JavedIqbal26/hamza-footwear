---
import BaseLayout from '../layouts/BaseLayout.astro';
import CatalogueView from '../components/ui/CatalogueView.astro';
import { browseCatalogue, parseCatalogueQuery } from '../lib/catalogue.js';
import { CATALOGUE_CACHE_CONTROL } from '../lib/cache.js';
import { getShopWhatsApp } from '../lib/runtime.js';
import { readWishlist } from '../lib/wishlist/session.js';

export const prerender = false;

/**
 * The whole catalogue in one browsable, filterable place.
 *
 * The category pages answer "show me women's shoes"; this answers "show me
 * everything you have", which is how someone shops a small store when they
 * arrived without a specific product in mind.
 */
const query = parseCatalogueQuery(Astro.url.searchParams);
const view = await browseCatalogue(Astro.locals, query);
const saved = readWishlist(Astro.cookies);

Astro.response.headers.set('Cache-Control', CATALOGUE_CACHE_CONTROL);
---

<BaseLayout
  title="All Shoes"
  description="Browse every style Hamza Footwear has in stock — men, women and kids. Delivered across Pakistan with Cash on Delivery."
  shopPhone={getShopWhatsApp(Astro.locals)}
>
  <CatalogueView heading="All Shoes" basePath="/shop" query={query} view={view} saved={saved} />
</BaseLayout>
