---
import BaseLayout from '../layouts/BaseLayout.astro';
import { TRUST } from '../content/microcopy.js';
import { listCities, summariseByTier } from '../lib/delivery.js';
import { CATALOGUE_CACHE_CONTROL } from '../lib/cache.js';

/*
 * Where the shop delivers — not what it charges.
 *
 * This page used to print a fee per tier from the cities table. Those figures
 * were the site's invention: the charge depends on the address and the owner
 * quotes it per order once he sees it. Publishing a number he has not agreed to
 * is how a customer ends up paying the wrong amount, so the list stays and the
 * prices go.
 */
export const prerender = false;

const cities = await listCities(Astro.locals);
const tiers = summariseByTier(cities);

const TIER_LABELS: Record<string, string> = {
  major: 'Major cities',
  other: 'Rest of Pakistan',
};

Astro.response.headers.set('Cache-Control', CATALOGUE_CACHE_CONTROL);
---

<BaseLayout
  title="Delivery"
  description="Delivery timings and charges for Hamza Footwear across Pakistan."
>
  <div class="mx-auto max-w-3xl px-4 pt-8">
    <h1 class="display text-[30px] sm:text-[38px]">Delivery</h1>
    <p class="mt-2 text-sm text-ink">{TRUST.deliveryTime}</p>
    <p class="mt-1 text-sm text-ink-muted">{TRUST.deliveryFeeNote}</p>

    <section class="mt-8 space-y-6">
      {
        tiers.map((tier) => (
          <div class="rounded-xl border border-line p-4">
            <h2 class="text-base font-semibold text-ink">
              {TIER_LABELS[tier.tier] ?? tier.tier}
            </h2>
            <p class="mt-2 text-sm text-ink-muted">{tier.cities.join(', ')}</p>
          </div>
        ))
      }
    </section>

    <section class="mt-8">
      <h2 class="display text-[22px]">Delivery charge</h2>
      <p class="mt-2 text-sm leading-relaxed text-ink">{TRUST.quotePending}</p>
    </section>

    <section class="mt-8">
      <h2 class="display text-[22px]">Payment</h2>
      <p class="mt-2 text-sm text-ink">{TRUST.cod}</p>
      <p class="mt-2 text-sm text-ink">{TRUST.codAdvance}</p>
      <p class="mt-2 text-sm text-ink-muted">
        Your city is not on the list? Message us on WhatsApp — hum aap ke liye
        check kar lete hain.
      </p>
    </section>
  </div>
</BaseLayout>
