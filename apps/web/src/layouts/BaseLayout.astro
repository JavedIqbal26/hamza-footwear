---
import BottomTabBar from '../components/ui/BottomTabBar.astro';
import SiteFooter from '../components/ui/SiteFooter.astro';
import SiteHeader from '../components/ui/SiteHeader.astro';
import { SITE } from '../lib/site.js';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  /** Absolute or root-relative image for link previews (TikTok, WhatsApp). */
  image?: string;
  /** Set on pages that should not appear in search results. */
  noindex?: boolean;
  /** Prefills the header search box on search result pages. */
  query?: string;
  /** The shop's WhatsApp number, for the bottom tab bar. */
  shopPhone?: string;
  /** Checkout and sign-in hide the chrome to keep the flow single-minded. */
  bare?: boolean;
  /**
   * Product pages hide the tab bar: their own sticky Add-to-cart bar occupies
   * that space, and two stacked dark bars read as one broken one.
   */
  hideTabBar?: boolean;
}

const {
  title,
  description = SITE.description,
  image,
  noindex = false,
  query = '',
  shopPhone = '',
  bare = false,
  hideTabBar = false,
} = Astro.props;

const pageTitle = title === SITE.name ? title : `${title} — ${SITE.name}`;
const canonical = new URL(Astro.url.pathname, SITE.url).href;
const socialImage = image ? new URL(image, SITE.url).href : undefined;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}

    {/*
      The display face is declared in global.css and self-hosted, so it never
      touches fonts.googleapis.com.

      No `<link rel="preload">` for it yet: the woff2 is not in the repo (see
      README), and preloading a missing file 404s on every page load. Once the
      font is added, add the preload here too — it renders the first heading on
      most pages, which is usually the LCP element:

        <link rel="preload" href="/fonts/instrument-serif-400.woff2"
              as="font" type="font/woff2" crossorigin />
    */}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {socialImage && <meta property="og:image" content={socialImage} />}
    <meta name="twitter:card" content="summary_large_image" />

    <meta name="theme-color" content="#17120f" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>

  <body class="flex min-h-dvh flex-col bg-surface-sunk">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-2 focus:top-2 focus:z-50 focus:rounded focus:bg-surface focus:px-4 focus:py-2 focus:shadow"
    >
      Skip to content
    </a>

    {!bare && <SiteHeader query={query} />}

    {/*
      The bottom tab bar is sticky, so it paints over whatever is beneath it.
      Without this clearance it covered the primary action on short pages —
      Checkout on the cart, Place order on checkout. Only applied when the bar
      is actually rendered.
    */}
    <main
      id="main"
      class:list={['flex-1 bg-surface', !bare && !hideTabBar && 'pb-20 sm:pb-0']}
    >
      <slot />
    </main>

    {!bare && <SiteFooter />}
    {!bare && !hideTabBar && <BottomTabBar shopPhone={shopPhone} />}
  </body>
</html>
